PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/krishi_connect
JWT_SECRET=krishi_connect_super_secret_jwt_key_2026_agro_market
JWT_EXPIRES_IN=7d
STORAGE_MODE=auto

# --- Email OTP (Brevo) ---
# Set these in Render -> Environment (never commit real keys)
BREVO_API_KEY=
MAIL_FROM=
# OTP_LOGIN=off   (uncomment to skip OTP at login; register and password reset still use OTP)

# --- API login check ---
# on = every API call needs a valid login token. Test first, then turn on. off = old behaviour.
REQUIRE_AUTH=off
